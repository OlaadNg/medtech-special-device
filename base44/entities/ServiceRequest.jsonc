{
  "name": "ServiceRequest",
  "type": "object",
  "properties": {
    "ticket_number": {
      "type": "string"
    },
    "request_type": {
      "type": "string",
      "enum": [
        "Preventive Maintenance",
        "Equipment Repair",
        "Calibration",
        "Installation",
        "Compliance Testing",
        "Technical Support",
        "Warranty Claim",
        "Emergency Service"
      ]
    },
    "description": {
      "type": "string"
    },
    "equipment_name": {
      "type": "string"
    },
    "equipment_serial": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "priority": {
      "type": "string",
      "enum": [
        "Low",
        "Medium",
        "High",
        "Critical"
      ],
      "default": "Medium"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "in_progress",
        "pending_parts",
        "resolved",
        "closed"
      ],
      "default": "open"
    },
    "assigned_engineer": {
      "type": "string"
    },
    "scheduled_date": {
      "type": "string",
      "format": "date"
    },
    "resolved_date": {
      "type": "string",
      "format": "date"
    },
    "resolution_notes": {
      "type": "string"
    },
    "attachment_url": {
      "type": "string"
    }
  },
  "required": [
    "request_type",
    "description",
    "equipment_name"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}